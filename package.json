{
  "name": "md-editor",
  "version": "0.1.0",
  "description": "A simple Markdown editor and viewer",
  "author": "Eugenia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ermellinka/md-editor.git"
  },
  "homepage": "https://github.com/ermellinka/md-editor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test tests/file-store.test.js",
    "test:renderer": "electron tests/renderer.cjs"
  },
  "dependencies": {
    "dompurify": "^3.1.6",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.eugenia.mdeditor",
    "productName": "MD Editor",
    "files": ["main.js", "preload.js", "file-store.js", "renderer/**", "node_modules/marked/**", "node_modules/dompurify/**"],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MD Editor"
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "role": "Editor"
      }
    ]
  }
}
